# Copy this file to .env (or .env.local) and fill in real values.
# Never commit the actual .env / .env.local files — they are Git-ignored.

# Firebase client config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Razorpay — public key (safe to expose to the browser, used by the checkout widget)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Razorpay — server-side only, must NEVER be exposed to the browser
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Genkit / Gemini
GEMINI_API_KEY=
