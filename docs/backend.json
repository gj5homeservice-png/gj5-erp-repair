
{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "Retail customer profile for tracking and CRM.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "address": { "type": "string" },
        "pincode": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "mobile"]
    },
    "TVProduct": {
      "title": "TV Product",
      "description": "Smart TV asset with technical specifications and pricing.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "size": { "type": "string" },
        "os": { "type": "string" },
        "resolution": { "type": "string" },
        "features": { "type": "array" },
        "mrp": { "type": "number" },
        "offerPrice": { "type": "number" },
        "warranty": { "type": "string" },
        "stock": { "type": "number" },
        "imageUrl": { "type": "string" },
        "isOffer": { "type": "boolean" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "brand", "offerPrice", "stock"]
    },
    "Inquiry": {
      "title": "Customer Inquiry",
      "description": "Lead management for potential sales and service.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "mobile": { "type": "string" },
        "address": { "type": "string" },
        "pincode": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["New", "Pending", "Confirmed", "Delivered", "Cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "mobile", "status"]
    },
    "Order": {
      "title": "Sales Order",
      "description": "Direct purchase order tracking.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerMobile": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Processed", "Shipped", "Delivered", "Cancelled"] },
        "paymentMode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "totalAmount", "status"]
    },
    "Offer": {
      "title": "Promotional Offer",
      "description": "Flash deals and seasonal discounts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "discount": { "type": "string" },
        "expiryDate": { "type": "string", "format": "date" },
        "active": { "type": "boolean" }
      },
      "required": ["title", "discount"]
    },
    "SaaSCompany": {
      "title": "Enterprise Node",
      "description": "Registered business using GJ5 ERP.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Trial", "Expired", "Suspended"] },
        "planId": { "type": "string" },
        "expiryDate": { "type": "string", "format": "date-time" },
        "dbPath": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "SaaSPlan": {
      "title": "Subscription Plan",
      "description": "Defined service level agreement and limits.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "durationDays": { "type": "number" },
        "limits": { "type": "object" },
        "active": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/saas_companies/{companyId}": {
      "schema": "#/backend/entities/SaaSCompany",
      "description": "Global enterprise registry."
    },
    "/saas_plans/{planId}": {
      "schema": "#/backend/entities/SaaSPlan",
      "description": "Subscription tier definitions."
    },
    "/saas_payments/{paymentId}": {
      "schema": "object",
      "description": "Global transaction ledger."
    },
    "/saas_logs/{logId}": {
      "schema": "object",
      "description": "System-wide audit trail."
    }
  }
}
