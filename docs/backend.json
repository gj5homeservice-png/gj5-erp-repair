
{
  "entities": {
    "Company": {
      "title": "Company",
      "description": "Master enterprise node registry and workspace metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerEmail": { "type": "string", "format": "email" },
        "ownerMobile": { "type": "string" },
        "logoUrl": { "type": "string" },
        "planName": { "type": "string" },
        "planStartDate": { "type": "string", "format": "date-time" },
        "planExpiryDate": { "type": "string", "format": "date-time" },
        "subscriptionStatus": { "type": "string", "enum": ["active", "expired", "trial", "pending"] },
        "companyStatus": { "type": "string", "enum": ["active", "suspended", "blocked"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "workspaceId": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "couponCode": { "type": "string" },
        "isBlocked": { "type": "boolean" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "pincode": { "type": "string" },
        "category": { "type": "string" },
        "services": { "type": "string" },
        "gstNumber": { "type": "string" }
      },
      "required": ["companyName", "ownerEmail", "subscriptionStatus"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Retail customer profile for tracking and CRM.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "address": { "type": "string" },
        "pincode": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "mobile"]
    },
    "TVProduct": {
      "title": "TV Product",
      "description": "Smart TV asset with technical specifications and pricing.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "size": { "type": "string" },
        "os": { "type": "string" },
        "resolution": { "type": "string" },
        "features": { "type": "array" },
        "mrp": { "type": "number" },
        "offerPrice": { "type": "number" },
        "warranty": { "type": "string" },
        "stock": { "type": "number" },
        "imageUrl": { "type": "string" },
        "isOffer": { "type": "boolean" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "brand", "offerPrice", "stock"]
    },
    "Inquiry": {
      "title": "Customer Inquiry",
      "description": "Lead management for potential sales and service.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "mobile": { "type": "string" },
        "address": { "type": "string" },
        "pincode": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["New", "Pending", "Confirmed", "Delivered", "Cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "mobile", "status"]
    },
    "Coupon": {
      "title": "Promotion Coupon",
      "description": "Marketing coupon for plan discounts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "discountType": { "type": "string", "enum": ["Percentage", "Fixed Amount"] },
        "discountValue": { "type": "number" },
        "applicablePlans": { "type": "array" },
        "maxUses": { "type": "number" },
        "usedCount": { "type": "number" },
        "active": { "type": "boolean" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "Subscription": {
      "title": "License Subscription",
      "description": "Active business license for an enterprise node.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "companyId": { "type": "string" },
        "planName": { "type": "string" },
        "originalAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "finalAmount": { "type": "number" },
        "startDate": { "type": "string", "format": "date-time" },
        "expiryDate": { "type": "string", "format": "date-time" },
        "active": { "type": "boolean" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" }
      }
    },
    "Payment": {
      "title": "Financial Transaction",
      "description": "Secure record of fiscal settlement.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "paymentId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string" },
        "userId": { "type": "string" },
        "planId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": "#/backend/entities/Company",
      "description": "Global enterprise registry."
    },
    "/saas_plans/{planId}": {
      "schema": "#/backend/entities/SaaSPlan",
      "description": "Subscription tier definitions."
    },
    "/coupons/{couponId}": {
      "schema": "#/backend/entities/Coupon",
      "description": "Global marketing coupons."
    },
    "/subscriptions/{subId}": {
      "schema": "#/backend/entities/Subscription",
      "description": "Enterprise license records."
    },
    "/payments/{paymentId}": {
      "schema": "#/backend/entities/Payment",
      "description": "Financial settlement records."
    }
  }
}
