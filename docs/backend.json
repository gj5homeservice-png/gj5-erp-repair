{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "Retail customer profile for tracking and CRM.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "address": { "type": "string" },
        "pincode": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "mobile"]
    },
    "TVProduct": {
      "title": "TV Product",
      "description": "Smart TV asset with technical specifications and pricing.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "size": { "type": "string" },
        "os": { "type": "string" },
        "resolution": { "type": "string" },
        "features": { "type": "array" },
        "mrp": { "type": "number" },
        "offerPrice": { "type": "number" },
        "warranty": { "type": "string" },
        "stock": { "type": "number" },
        "imageUrl": { "type": "string" },
        "isOffer": { "type": "boolean" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "brand", "offerPrice", "stock"]
    },
    "Inquiry": {
      "title": "Customer Inquiry",
      "description": "Lead management for potential sales and service.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "mobile": { "type": "string" },
        "address": { "type": "string" },
        "pincode": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["New", "Pending", "Confirmed", "Delivered", "Cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "mobile", "status"]
    },
    "Coupon": {
      "title": "Promotion Coupon",
      "description": "Marketing coupon for plan discounts.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "discountType": { "type": "string", "enum": ["Percentage", "Fixed Amount"] },
        "discountValue": { "type": "number" },
        "applicablePlans": { "type": "array" },
        "maxUses": { "type": "number" },
        "usedCount": { "type": "number" },
        "active": { "type": "boolean" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "Subscription": {
      "title": "License Subscription",
      "description": "Active business license for an enterprise node.",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "planName": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "expiryDate": { "type": "string", "format": "date-time" },
        "active": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/saas_companies/{companyId}": {
      "schema": "#/backend/entities/SaaSCompany",
      "description": "Global enterprise registry."
    },
    "/saas_plans/{planId}": {
      "schema": "#/backend/entities/SaaSPlan",
      "description": "Subscription tier definitions."
    },
    "/coupons/{couponId}": {
      "schema": "#/backend/entities/Coupon",
      "description": "Global marketing coupons."
    },
    "/subscriptions/{subId}": {
      "schema": "#/backend/entities/Subscription",
      "description": "Enterprise license records."
    }
  }
}