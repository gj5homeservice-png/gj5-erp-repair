{
  "productName": "GJ5 HOME SERVICE",
  "version": "2.8.0",
  "identifier": "com.gj5.erp",
  "bundle": {
    "active": true,
    "targets": ["all"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "GJ5 HOME SERVICE | Enterprise Console",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:9002",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  }
}
